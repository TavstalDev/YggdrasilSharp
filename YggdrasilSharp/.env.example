# Copy this file to YggdrasilSharp/.env and set secure values locally. DO NOT commit your real secrets.
# Use a secure random string for each key below (at least 32 bytes recommended), and never reuse the same value.
# Used for AES-GCM data encryption and JWT signing/encryption.
JWT_ENCRYPTION_KEY=replace_with_secure_random_value
# Used to HMAC-sign machine (device) fingerprints.
FINGERPRINT_SIGNING_KEY=replace_with_secure_random_value
# Used to encrypt/decrypt stored two-factor (TOTP) secrets.
TWO_FACTOR_ENCRYPTION_KEY=replace_with_secure_random_value

# Database credentials
DB_USER=replace_db_user
DB_PASSWORD=replace_db_password

# Email credentials used for sending mails (development values okay for local testing)
EMAIL_ADDRESS=example@example.com
EMAIL_PASSWORD=replace_email_password

# SSL Certificate
# Windows: Use the SHA-1 hash fingerprint of the certificate
# Linux/Mac: Use the absolute path to a PKCS#12 certificate file (e.g., /path/to/certificate.pfx)
CERTIFICATE_FINGERPRINT=replace_with_certificate_fingerprint
CERTIFICATE_PASSWORD=replace_certificate_password
